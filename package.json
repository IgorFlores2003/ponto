{
  "name": "ponto-digital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "build": "tsc -b --force && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "admin:create": "node server/create-admin.js",
    "db:seed": "node server/seed.js",
    "db:seed:admin": "node server/seed-admin.js",
    "db:migrate": "node server/migrate.js",
    "db:check": "node server/check-db.js",
    "env:check": "node server/check-env.js",
    "capacitor:sync:before": "npm run build",
    "android:sync": "cap sync android",
    "android:release": "node scripts/android-release.mjs",
    "supabase:storage:setup": "node server/setup-supabase-storage.js",
    "supabase:smtp:setup": "node server/setup-supabase-smtp.js",
    "photos:migrate": "node server/migrate-photos.js",
    "photos:prune": "node server/prune-photos.js",
    "supabase:terminal:link": "node server/link-supabase-terminal.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
