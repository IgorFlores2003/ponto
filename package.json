{
  "name": "ponto-digital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "build": "tsc -b --force && vite build",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "admin:create": "node server/create-admin.js",
    "db:seed": "node server/seed.js",
    "db:migrate": "node server/migrate.js",
    "db:check": "node server/check-db.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
