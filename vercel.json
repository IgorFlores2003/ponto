{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/maintenance/photos", "schedule": "0 5 * * *" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/certs/**",
      "excludeFiles": "{.env,.env.*,data/**,android/**,server/seeds/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__api_path=:path*" }
  ]
}
