# Para Android/dispositivos externos, informe a URL pública do backend antes do build.
# VITE_API_URL=https://seu-servidor.example/api

# Apenas backend: nunca use VITE_ nas credenciais de banco.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@HOST:6543/postgres
# DATABASE_CA_PATH=server/certs/supabase.crt
# Sem DATABASE_URL, usa SQLite em data/ponto.sqlite.

# Migração gradual: os valores padrão preservam o login administrativo e as fotos existentes.
# TERMINAL_AUTH_PROVIDER=local
# PHOTO_STORAGE=database
# O modo local libera o terminal com as credenciais administrativas, em uma sessão separada.
# Ative supabase em cada opção somente após seguir docs/supabase.md.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# Chaves legadas também são aceitas: SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_STORAGE_BUCKET=ponto-fotos
# AUTH_SESSION_ENCRYPTION_KEY=64_caracteres_hexadecimais_gerados_aleatoriamente
# As chaves acima são exclusivas do backend. Nunca use prefixo VITE_.

# Use apenas se houver exatamente um proxy confiável e o backend não aceitar acesso direto.
# TRUST_PROXY=1
